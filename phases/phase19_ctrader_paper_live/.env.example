# cTrader Open API app credentials
CTRADER_CLIENT_ID=replace_me
CTRADER_CLIENT_SECRET=replace_me

# Filled by the OAuth helper
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_TOKEN_TYPE=Bearer
CTRADER_ACCESS_TOKEN_EXPIRES_AT_UTC=
CTRADER_SCOPE=trading
CTRADER_REDIRECT_URI=http://localhost/

# Optional fixed account id (empty/0 selects the first DEMO account)
CTRADER_ACCOUNT_ID=0
